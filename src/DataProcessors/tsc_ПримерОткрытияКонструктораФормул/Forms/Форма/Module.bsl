&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Если есть библиотека БСП и есть справочник Идентификаторы объектов метаданных, то будем выбирать из него
	// Если нет - то сформируем дерево метаданных самостоятельно
	ТипСправочникаБСП = tsc_ОбщегоНазначения.ТипЗначенияОпределяемогоТипа(Метаданные.ОпределяемыеТипы.tsc_СправочникИдентификаторыОбъектовМетаданных);
	Если ТипСправочникаБСП = Неопределено Тогда
		Элементы.ГруппаСБСП.Видимость = Ложь;
		Элементы.ГруппаМетаданные.ТекущаяСтраница = Элементы.ГруппаБезБСП;
	Иначе
		Элементы.ГруппаБезБСП.Видимость = Ложь;
		Элементы.ГруппаМетаданные.ТекущаяСтраница = Элементы.ГруппаСБСП;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКДаннымНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОграниченияРазвертки = tsc_РаботаСФормуламиКлиентСервер.ОграниченияРазверткиОперандов();
	ОграниченияРазвертки.НеВыводимыеРеквизиты = "ВерсияДанных";
	ОграниченияРазвертки.ВыводитьТабличныеЧасти = Истина;
	ОграниченияРазвертки.РеквизитыИТабличныеЧастиВГруппах = Ложь;
	ОграниченияРазвертки.НеВыводимыеТабличныеЧасти = "КонтактнаяИнформация,ДополнительныеРеквизиты";
	ОграниченияРазвертки.НеВыводитьРеквизитыИТабличныеЧастиНачинающиесяСУдалить = Ложь;
	ОграниченияРазвертки.ВыводитьТЧТолькоНа1омУровне = Ложь;
	ОграниченияРазвертки.РазворачиватьСтрокиАлгоритмов = Истина;
	
	Если ЗначениеЗаполнено(ТипДанных) Тогда
		ОтборПоТипуДанных = Новый ОписаниеТипов(ТипДанных);
	Иначе
		ОтборПоТипуДанных = Новый ОписаниеТипов("Неопределено");
	КонецЕсли;
	ПараметрыРедактированияВыражения = Новый Структура;
	ПараметрыРедактированияВыражения.Вставить("ТипЗначения", 				ОтборПоТипуДанных);
	ПараметрыРедактированияВыражения.Вставить("АдресСхемыКомпоновкиДанных", АдресСхемыКомпоновкиДанныхЛюбыеМетаданные(ЭтаФорма.УникальныйИдентификатор, МетаданныеСтрока));
	ПараметрыРедактированияВыражения.Вставить("ОграниченияРазвертки", 		ОграниченияРазвертки);	
	ПараметрыРедактированияВыражения.Вставить("ТекущееВыражение",           ПутьКДанным);
	ПараметрыРедактированияВыражения.Вставить("ОтборПоТипуЗначения", 		ОтборПоТипу);
	
	ДополнительныеПараметры = Новый Структура("Форма, Элемент", ЭтаФорма, Элемент);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборПоляЗаполненияАналитикиПослеЗакрытия", ЭтотОбъект,
		ДополнительныеПараметры);
		
		
	ОткрытьФорму(
		"ОбщаяФорма.tsc_ВыборПоляПутиКДанным",
		ПараметрыРедактированияВыражения,
		ЭтаФорма,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборПоляЗаполненияАналитикиПослеЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	Элемент = ДополнительныеПараметры.Элемент;
	
	Если Результат <> Неопределено Тогда
		Результат = СокрЛП(Результат);
		Если Форма[Элемент.Имя] <> Результат Тогда
			Форма.Модифицированность = Истина;
			Форма[Элемент.Имя] = Результат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

