// Процедура - Получить руководителя
//
// Параметры:
//  ТаблицаДанных					 - 	 - 
//  ИдентификаторАлгоритма			 - 	 - 
//  КолонкаРезультат				 - 	 - 
//  КолонкаИсточник					 - 	 - 
//  ДополнительныеВыраженияАлгоритма - 	 - 
//  Контекст						 - 	 - 
//  КешДанных						 - 	 - 
//  ТекстОшибки						 - 	 - 
//
Процедура ПолучитьРуководителя(ТаблицаДанных, ИдентификаторАлгоритма, КолонкаРезультат, КолонкаИсточник, ДополнительныеВыраженияАлгоритма, Контекст, КешДанных, ТекстОшибки = "") Экспорт
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыАлгоритма = СтрРазделить(ИдентификаторАлгоритма, "|");
	ТипРуководителяИдентификатор = ПараметрыАлгоритма[0];
	ТипРуководителя = Справочники["ТЦР_ТипыРуководителей"].НайтиПоРеквизиту("ИдентификаторДляФормул", ТипРуководителяИдентификатор);
	КолонкаЗапроса = ПараметрыАлгоритма[1]; 
	
	ПроверитьВКеше = Истина;
	Если КешДанных = Неопределено Тогда
		КешДанных = Новый ТаблицаЗначений;
		ПроверитьВКеше = Ложь;
	КонецЕсли;
	Если ТипЗнч(КешДанных) = Тип("ТаблицаЗначений") Тогда
		Если КешДанных.Колонки.Количество() = 0 Тогда
			ПроверитьВКеше = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	ИмяКолонкиДата = Неопределено;
	Если ДополнительныеВыраженияАлгоритма.Количество() > 0 Тогда
		СтруктураВыражениеКолонка = ДополнительныеВыраженияАлгоритма[0];
		ИмяКолонкиДата = СтруктураВыражениеКолонка.ИмяКолонки;
	КонецЕсли;
	
	СтрокиКЗапросу = Новый Массив;
	Если ПроверитьВКеше Тогда
		КешДанных.Индексы.Очистить();
		КешДанных.Индексы.Добавить("ОбъектРуководителя, ТипРуководителя, Дата");
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[КолонкаИсточник]) Тогда
				Продолжить;
			КонецЕсли;
			Поиск = Новый Структура;
			Поиск.Вставить("ОбъектРуководителя", СтрокаТаблицы[КолонкаИсточник]);
			Поиск.Вставить("ТипРуководителя", ТипРуководителя);
			Если ИмяКолонкиДата = Неопределено Тогда
				Поиск.Вставить("Дата", ТекущаяДатаСеанса);
			Иначе
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонкиДата]) Тогда
					Поиск.Вставить("Дата", ТекущаяДатаСеанса);
				Иначе
					Поиск.Вставить("Дата", СтрокаТаблицы[ИмяКолонкиДата]);
				КонецЕсли;
			КонецЕсли;
			
			НайденныеСтроки = КешДанных.НайтиСтроки(Поиск);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокиКЗапросу.Добавить(СтрокаТаблицы);
			Иначе
				СтрокаТаблицы[КолонкаРезультат] = НайденныеСтроки[0][КолонкаЗапроса];
			КонецЕсли;
		КонецЦикла;
		КешДанных.Индексы.Очистить();
	КонецЕсли;
	
	Если ПроверитьВКеше = Ложь
		ИЛИ СтрокиКЗапросу.Количество() > 0 Тогда
	
		ТаблицаВЗапрос = Новый ТаблицаЗначений;
		ТаблицаВЗапрос.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0,ДопустимыйЗнак.Неотрицательный)));
		ТаблицаВЗапрос.Колонки.Добавить("ОбъектРуководителя", Метаданные.РегистрыСведений["ТЦР_Руководители"].Измерения.ОбъектРуководителя.Тип);
		ТаблицаВЗапрос.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		
	КонецЕсли;
	Если ПроверитьВКеше = Ложь Тогда
		Коллекциия = ТаблицаДанных;
	Иначе
		Коллекциия = СтрокиКЗапросу;
	КонецЕсли;
	Для каждого ИсходнаяСтрока Из Коллекциия Цикл
		Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока[КолонкаИсточник]) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаВЗапрос.Добавить();
		НоваяСтрока.ИндексСтроки = ИсходнаяСтрока.ИндексСтроки;
		НоваяСтрока.ОбъектРуководителя = ИсходнаяСтрока[КолонкаИсточник];
		Если ИмяКолонкиДата = Неопределено Тогда
			НоваяСтрока.Дата = ТекущаяДатаСеанса;
		Иначе
			НоваяСтрока.Дата = ИсходнаяСтрока[ИмяКолонкиДата];	
			Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока[ИмяКолонкиДата]) Тогда
				НоваяСтрока.Дата = ТекущаяДатаСеанса;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПроверитьВКеше = Ложь
		ИЛИ СтрокиКЗапросу.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаВЗапрос", ТаблицаВЗапрос);
		Запрос.УстановитьПараметр("ВидСобытияУвольнение", Перечисления["ВидыКадровыхСобытий"].Увольнение);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ИндексСтроки КАК ИндексСтроки,
		|	Т.ОбъектРуководителя КАК ОбъектРуководителя,
		|	Т.Дата КАК Дата
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТаблицаВЗапрос КАК Т
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Т.ОбъектРуководителя,
		|	Т.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЦР_ТипыРуководителей.Ссылка КАК ТипРуководителя,
		|	ТЦР_ТипыРуководителей.Наименование КАК Наименование,
		|	ТЦР_ТипыРуководителей.Представление КАК Представление,
		|	ТЦР_ТипыРуководителей.Код КАК Код,
		|	ТЦР_ТипыРуководителей.ИдентификаторДляФормул КАК ИдентификаторДляФормул
		|ПОМЕСТИТЬ ТипыРуководителей
		|ИЗ
		|	Справочник.ТЦР_ТипыРуководителей КАК ТЦР_ТипыРуководителей
		|ГДЕ
		|	НЕ ТЦР_ТипыРуководителей.ПометкаУдаления
		|	И НЕ ТЦР_ТипыРуководителей.Архив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.Период КАК Период,
		|	Рег.ОбъектРуководителя КАК ОбъектРуководителя,
		|	Рег.ТипРуководителя КАК ТипРуководителя,
		|	Рег.Руководитель КАК Руководитель
		|ПОМЕСТИТЬ Рег1
		|ИЗ
		|	РегистрСведений.ТЦР_Руководители КАК Рег
		|ГДЕ
		|	Рег.ОбъектРуководителя В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ВТ.ОбъектРуководителя
		|			ИЗ
		|				ВТ КАК ВТ)
		|	И Рег.ТипРуководителя В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				Т.ТипРуководителя
		|			ИЗ
		|				ТипыРуководителей КАК Т)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рег.ОбъектРуководителя,
		|	Рег.ТипРуководителя,
		|	Рег.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.ИндексСтроки КАК ИндексСтроки,
		|	Т.ОбъектРуководителя КАК ОбъектРуководителя,
		|	Т.Дата КАК Дата,
		|	Т.ТипРуководителя КАК ТипРуководителя,
		|	Т.Наименование КАК Наименование,
		|	Т.Представление КАК Представление,
		|	Т.Код КАК Код,
		|	Т.ИдентификаторДляФормул КАК ИдентификаторДляФормул,
		|	МАКСИМУМ(Рег1.Руководитель) КАК Руководитель
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ.ИндексСтроки КАК ИндексСтроки,
		|		ВТ.ОбъектРуководителя КАК ОбъектРуководителя,
		|		ВТ.Дата КАК Дата,
		|		ТипыРуководителей.ТипРуководителя КАК ТипРуководителя,
		|		ТипыРуководителей.Наименование КАК Наименование,
		|		ТипыРуководителей.Представление КАК Представление,
		|		ТипыРуководителей.Код КАК Код,
		|		ТипыРуководителей.ИдентификаторДляФормул КАК ИдентификаторДляФормул,
		|		МАКСИМУМ(Рег1.Период) КАК Период
		|	ИЗ
		|		ВТ КАК ВТ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Рег1 КАК Рег1
		|			ПО ВТ.ОбъектРуководителя = Рег1.ОбъектРуководителя
		|				И ВТ.Дата >= Рег1.Период
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТипыРуководителей КАК ТипыРуководителей
		|			ПО (Рег1.ТипРуководителя = ТипыРуководителей.ТипРуководителя)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ.ИндексСтроки,
		|		ВТ.ОбъектРуководителя,
		|		ВТ.Дата,
		|		ТипыРуководителей.ТипРуководителя,
		|		ТипыРуководителей.Наименование,
		|		ТипыРуководителей.Представление,
		|		ТипыРуководителей.Код,
		|		ТипыРуководителей.ИдентификаторДляФормул) КАК Т
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Рег1 КАК Рег1
		|		ПО Т.ОбъектРуководителя = Рег1.ОбъектРуководителя
		|			И Т.ТипРуководителя = Рег1.ТипРуководителя
		|			И Т.Период = Рег1.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.ИндексСтроки,
		|	Т.ОбъектРуководителя,
		|	Т.Дата,
		|	Т.ТипРуководителя,
		|	Т.Наименование,
		|	Т.Представление,
		|	Т.Код,
		|	Т.ИдентификаторДляФормул
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Руководитель,
		|	Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеДляПодбораСотрудников.Наименование КАК Наименование,
		|	ДанныеДляПодбораСотрудников.Сотрудник КАК Сотрудник,
		|	ДанныеДляПодбораСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеДляПодбораСотрудников.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	ДанныеДляПодбораСотрудников.ПоДоговоруГПХ КАК ПоДоговоруГПХ,
		|	ДанныеДляПодбораСотрудников.Филиал КАК Филиал,
		|	ДанныеДляПодбораСотрудников.Подразделение КАК Подразделение,
		|	ДанныеДляПодбораСотрудников.Организация КАК Организация,
		|	ДанныеДляПодбораСотрудников.Должность КАК Должность,
		|	ДанныеДляПодбораСотрудников.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию,
		|	ДанныеДляПодбораСотрудников.РабочееМесто КАК РабочееМесто,
		|	ДанныеДляПодбораСотрудников.ЭтоГоловнойСотрудник КАК ЭтоГоловнойСотрудник,
		|	ДанныеДляПодбораСотрудников.ВидЗанятости КАК ВидЗанятости,
		|	ДанныеДляПодбораСотрудников.ВидСобытия КАК ВидСобытия,
		|	ДанныеДляПодбораСотрудников.КоличествоСтавок КАК КоличествоСтавок,
		|	ДанныеДляПодбораСотрудников.КоличествоСтавокПредставление КАК КоличествоСтавокПредставление,
		|	ДанныеДляПодбораСотрудников.ВидДоговора КАК ВидДоговора,
		|	ДанныеДляПодбораСотрудников.Начало КАК Начало,
		|	ДанныеДляПодбораСотрудников.Окончание КАК Окончание,
		|	ДанныеДляПодбораСотрудников.МестоВСтруктуреПредприятия КАК МестоВСтруктуреПредприятия,
		|	ДанныеДляПодбораСотрудников.ПометкаУдаления КАК ПометкаУдаления,
		|	ДанныеДляПодбораСотрудников.Код КАК Код,
		|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи
		|ПОМЕСТИТЬ Рег2
		|ИЗ
		|	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбораСотрудников
		|ГДЕ
		|	(ДанныеДляПодбораСотрудников.ДолжностьПоШтатномуРасписанию В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ВТ2.Руководитель
		|				ИЗ
		|					ВТ2 КАК ВТ2
		|				ГДЕ
		|					ВТ2.Руководитель ССЫЛКА Справочник.ШтатноеРасписание)
		|			ИЛИ ДанныеДляПодбораСотрудников.Сотрудник В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ВТ2.Руководитель
		|				ИЗ
		|					ВТ2 КАК ВТ2
		|				ГДЕ
		|					ВТ2.Руководитель ССЫЛКА Справочник.Сотрудники))
		|	И ДанныеДляПодбораСотрудников.ВидСобытия <> &ВидСобытияУвольнение
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Сотрудник,
		|	Окончание,
		|	Окончание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.ИндексСтроки КАК ИндексСтроки,
		|	Т.ОбъектРуководителя КАК ОбъектРуководителя,
		|	Т.Дата КАК Дата,
		|	Т.ТипРуководителя КАК ТипРуководителя,
		|	Т.ТипРуководителя.Зависимый КАК ЗависимыйТип,
		|	Т.ТипРуководителя.ВышестоящийТипРуководителя КАК ВышестоящийТипРуководителя,
		|	Т.Наименование КАК Наименование,
		|	Т.Представление КАК Представление,
		|	Т.Код КАК Код,
		|	Т.ИдентификаторДляФормул КАК ИдентификаторДляФормул,
		|	Т.Руководитель КАК Руководитель,  
		|	Т.Сотрудник КАК Сотрудник,
		|	ВЫБОР
		|		КОГДА Рег2.ДолжностьПоШтатномуРасписанию ЕСТЬ NULL
		|			ТОГДА Т.Руководитель.Наименование
		|		ИНАЧЕ Т.Сотрудник.Наименование
		|	КОНЕЦ КАК Значение,
		|	ЕСТЬNULL(Рег2.ДолжностьПоШтатномуРасписанию, """") КАК ДолжностьПоШтатномуРасписанию,
		|	ЕСТЬNULL(Рег2.Должность, """") КАК Должность,
		|	ЕСТЬNULL(Рег2.ФизическоеЛицо.ФИО, """") КАК ФИО,
		|	ЕСТЬNULL(Рег2.ФизическоеЛицо.Фамилия, """") КАК Фамилия,
		|	ЕСТЬNULL(Рег2.ФизическоеЛицо.Имя, """") КАК Имя,
		|	ЕСТЬNULL(Рег2.ФизическоеЛицо.Отчество, """") КАК Отчество,
		|	ЕСТЬNULL(Рег2.ФизическоеЛицо.Инициалы, """") КАК Инициалы
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ2.ИндексСтроки КАК ИндексСтроки,
		|		ВТ2.ОбъектРуководителя КАК ОбъектРуководителя,
		|		ВТ2.Дата КАК Дата,
		|		ВТ2.ТипРуководителя КАК ТипРуководителя,
		|		ВТ2.Наименование КАК Наименование,
		|		ВТ2.Представление КАК Представление,
		|		ВТ2.Код КАК Код,
		|		ВТ2.ИдентификаторДляФормул КАК ИдентификаторДляФормул,
		|		ВТ2.Руководитель КАК Руководитель,
		|		МАКСИМУМ(Рег2.Сотрудник) КАК Сотрудник
		|	ИЗ
		|		ВТ2 КАК ВТ2
		|			ЛЕВОЕ СОЕДИНЕНИЕ Рег2 КАК Рег2
		|			ПО (ВТ2.Руководитель = Рег2.Сотрудник
		|					ИЛИ ВТ2.Руководитель = Рег2.ДолжностьПоШтатномуРасписанию)
		|				И (ВТ2.Дата МЕЖДУ Рег2.Начало И Рег2.Окончание)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ2.ИндексСтроки,
		|		ВТ2.ОбъектРуководителя,
		|		ВТ2.Дата,
		|		ВТ2.ТипРуководителя,
		|		ВТ2.Наименование,
		|		ВТ2.Представление,
		|		ВТ2.Код,
		|		ВТ2.ИдентификаторДляФормул,
		|		ВТ2.Руководитель) КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Рег2 КАК Рег2
		|		ПО Т.Сотрудник = Рег2.Сотрудник
		|			И Т.Дата <= Рег2.Окончание
		|			И Т.Дата >= Рег2.Начало
		|ГДЕ
		|	(Рег2.НомерЗаписи ЕСТЬ NULL
		|	ИЛИ Рег2.НомерЗаписи В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				Р.НомерЗаписи
		|			ИЗ
		|				Рег2 КАК Р
		|			ГДЕ
		|				Т.Сотрудник = Р.Сотрудник
		|				И Т.Дата <= Р.Окончание
		|				И Т.Дата >= Р.Начало
		|			УПОРЯДОЧИТЬ ПО
		|				Р.Окончание УБЫВ,
		|				Р.Начало УБЫВ))";
		
		Таблица = Запрос.Выполнить().Выгрузить();
		
		ТаблицаДанных.Индексы.Очистить();
		ТаблицаДанных.Индексы.Добавить("ИндексСтроки");
		Если НЕ ПроверитьВКеше Тогда
			КешДанных = Таблица;
		КонецЕсли;
		
		Если ПроверитьВКеше Тогда
			КешДанных.Индексы.Очистить();
			КешДанных.Индексы.Добавить("ОбъектРуководителя, Дата, ТипРуководителя");
		КонецЕсли;
			
		// Таблица получена по текущей ТаблицаДанных, так что можем искать строки по ИндексСтроки
		Для каждого Строка Из Таблица Цикл
			Если Строка.ТипРуководителя = ТипРуководителя Тогда
				ИндексСтроки = Строка.ИндексСтроки;
				ИсходнаяСтрока = ТаблицаДанных.Найти(ИндексСтроки, "ИндексСтроки");
				Если НЕ ИсходнаяСтрока = Неопределено Тогда
					ИсходнаяСтрока[КолонкаРезультат] = Строка[КолонкаЗапроса];
				КонецЕсли;
			КонецЕсли;
			
			Если ПроверитьВКеше Тогда
				ПоискПоКешу = Новый Структура("ОбъектРуководителя, Дата, ТипРуководителя");
				ЗаполнитьЗначенияСвойств(ПоискПоКешу, Строка);
				НайдСтрокиКеша = КешДанных.НайтиСтроки(ПоискПоКешу);
				Если НайдСтрокиКеша.Количество() = 0 Тогда 
					СтрокаКеша = КешДанных.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаКеша, Строка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		ТаблицаДанных.Индексы.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьПодписанта(ТаблицаДанных, ИдентификаторАлгоритма, КолонкаРезультат, КолонкаИсточник, ДополнительныеВыраженияАлгоритма, Контекст, КешДанных, ТекстОшибки = "") Экспорт 

	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыАлгоритма = СтрРазделить(ИдентификаторАлгоритма, "|");
	ТипПодписантаИдентификатор = ПараметрыАлгоритма[0];
	ТипПодписанта = Справочники["ТЦР_ТипыПодписантов"].НайтиПоРеквизиту("ИдентификаторДляФормул", ТипПодписантаИдентификатор);
	КолонкаЗапроса = ПараметрыАлгоритма[1]; 
	
	ПроверитьВКеше = Истина;
	Если КешДанных = Неопределено Тогда
		КешДанных = Новый ТаблицаЗначений;
		ПроверитьВКеше = Ложь;
	КонецЕсли;
	Если ТипЗнч(КешДанных) = Тип("ТаблицаЗначений") Тогда
		Если КешДанных.Колонки.Количество() = 0 Тогда
			ПроверитьВКеше = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	ИмяКолонкиДата = Неопределено;
	Если ДополнительныеВыраженияАлгоритма.Количество() > 0 Тогда
		СтруктураВыражениеКолонка = ДополнительныеВыраженияАлгоритма[0];
		ИмяКолонкиДата = СтруктураВыражениеКолонка.ИмяКолонки;
	КонецЕсли;
	
	СтрокиКЗапросу = Новый Массив;
	Если ПроверитьВКеше Тогда
		КешДанных.Индексы.Очистить();
		КешДанных.Индексы.Добавить("ОбъектПодписанта, ТипПодписанта, Дата");
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[КолонкаИсточник]) Тогда
				Продолжить;
			КонецЕсли;
			Поиск = Новый Структура;
			Поиск.Вставить("ОбъектПодписанта", СтрокаТаблицы[КолонкаИсточник]);
			Поиск.Вставить("ТипПодписанта", ТипПодписанта);
			Если ИмяКолонкиДата = Неопределено Тогда
				Поиск.Вставить("Дата", ТекущаяДатаСеанса);
			Иначе
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонкиДата]) Тогда
					Поиск.Вставить("Дата", ТекущаяДатаСеанса);
				Иначе
					Поиск.Вставить("Дата", СтрокаТаблицы[ИмяКолонкиДата]);
				КонецЕсли;
			КонецЕсли;
			
			НайденныеСтроки = КешДанных.НайтиСтроки(Поиск);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокиКЗапросу.Добавить(СтрокаТаблицы);
			Иначе
				СтрокаТаблицы[КолонкаРезультат] = НайденныеСтроки[0][КолонкаЗапроса];	
			КонецЕсли;
		КонецЦикла;
		КешДанных.Индексы.Очистить();
	КонецЕсли;
	
	Если ПроверитьВКеше = Ложь
		ИЛИ СтрокиКЗапросу.Количество() > 0 Тогда
	
		ТаблицаВЗапрос = Новый ТаблицаЗначений;
		ТаблицаВЗапрос.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0,ДопустимыйЗнак.Неотрицательный)));
		ТаблицаВЗапрос.Колонки.Добавить("ОбъектПодписанта", Метаданные.РегистрыСведений["ТЦР_Подписанты"].Измерения.ОбъектПодписанта.Тип);
		ТаблицаВЗапрос.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		
	КонецЕсли;
	Если ПроверитьВКеше = Ложь Тогда
		Коллекциия = ТаблицаДанных;
	Иначе
		Коллекциия = СтрокиКЗапросу;
	КонецЕсли;
	Для каждого ИсходнаяСтрока Из Коллекциия Цикл
		Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока[КолонкаИсточник]) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаВЗапрос.Добавить();
		НоваяСтрока.ИндексСтроки = ИсходнаяСтрока.ИндексСтроки;
		НоваяСтрока.ОбъектПодписанта = ИсходнаяСтрока[КолонкаИсточник];
		Если ИмяКолонкиДата = Неопределено Тогда
			НоваяСтрока.Дата = ТекущаяДатаСеанса;
		Иначе
			НоваяСтрока.Дата = ИсходнаяСтрока[ИмяКолонкиДата];	
			Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока[ИмяКолонкиДата]) Тогда
				НоваяСтрока.Дата = ТекущаяДатаСеанса;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПроверитьВКеше = Ложь
		ИЛИ СтрокиКЗапросу.Количество() > 0 Тогда
		
		МодульТЦР_Подписанты = ОбщегоНазначения.ОбщийМодуль("ТЦР_Подписанты");
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаВЗапрос", ТаблицаВЗапрос);
		Запрос.УстановитьПараметр("СостоянияОтсутствияСотрудников", МодульТЦР_Подписанты.СостоянияОтсутствияСотрудников());
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ИндексСтроки КАК ИндексСтроки,
		|	Т.ОбъектПодписанта КАК ОбъектПодписанта,
		|	Т.Дата КАК Дата
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТаблицаВЗапрос КАК Т
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Т.ОбъектПодписанта,
		|	Т.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ   
		|	ТЦР_ТипыПодписантов.Ссылка КАК ТипПодписанта,
		|	ТЦР_ТипыПодписантов.Наименование КАК Наименование,
		|	ТЦР_ТипыПодписантов.Представление КАК Представление,
		|	ТЦР_ТипыПодписантов.Код КАК Код,
		|	ТЦР_ТипыПодписантов.ИдентификаторДляФормул КАК ИдентификаторДляФормул
		|ПОМЕСТИТЬ ТипыПодписантов
		|ИЗ
		|	Справочник.ТЦР_ТипыПодписантов КАК ТЦР_ТипыПодписантов
		|ГДЕ
		|	НЕ ТЦР_ТипыПодписантов.Архив
		|	И НЕ ТЦР_ТипыПодписантов.ПометкаУдаления
		|ИНДЕКСИРОВАТЬ ПО
		|	ТЦР_ТипыПодписантов.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.Период КАК Период,
		|	Рег.ОбъектПодписанта КАК ОбъектПодписанта,
		|	Рег.ТипПодписанта КАК ТипПодписанта,
		|	Рег.Подписант КАК Подписант,
		|	Рег.Должность КАК Должность,
		|	Рег.ОснованиеПодписиПодписант КАК ОснованиеПодписиПодписант,
		|	Рег.Заместитель КАК Заместитель,
		|	Рег.ДолжностьЗаместитель КАК ДолжностьЗаместитель,
		|	Рег.ОснованиеПодписиЗаместитель КАК ОснованиеПодписиЗаместитель
		|ПОМЕСТИТЬ Рег1
		|ИЗ
		|	РегистрСведений.ТЦР_Подписанты КАК Рег
		|ГДЕ
		|	Рег.ОбъектПодписанта В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ВТ.ОбъектПодписанта
		|			ИЗ
		|				ВТ КАК ВТ)
		|	И Рег.ТипПодписанта В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				Т.ТипПодписанта
		|			ИЗ
		|				ТипыПодписантов КАК Т)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рег.ОбъектПодписанта,
		|	Рег.ТипПодписанта,
		|	Рег.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.ИндексСтроки КАК ИндексСтроки,
		|	Т.ОбъектПодписанта КАК ОбъектПодписанта,
		|	Т.Дата КАК Дата,
		|	Т.ТипПодписанта КАК ТипПодписанта,
		|	Т.Наименование КАК Наименование,
		|	Т.Представление КАК Представление,
		|	Т.Код КАК Код,
		|	Т.ИдентификаторДляФормул КАК ИдентификаторДляФормул,
		|	(Рег1.Подписант) КАК Подписант,
		|	(Рег1.Должность) КАК Должность,
		|	(Рег1.ОснованиеПодписиПодписант) КАК ОснованиеПодписиПодписант,
		|	(Рег1.Заместитель) КАК Заместитель,
		|	(Рег1.ДолжностьЗаместитель) КАК ДолжностьЗаместитель,
		|	(Рег1.ОснованиеПодписиЗаместитель) КАК ОснованиеПодписиЗаместитель
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ.ИндексСтроки КАК ИндексСтроки,
		|		ВТ.ОбъектПодписанта КАК ОбъектПодписанта,
		|		ВТ.Дата КАК Дата,
		|		ТипыПодписантов.ТипПодписанта КАК ТипПодписанта,
		|		ТипыПодписантов.Наименование КАК Наименование,
		|		ТипыПодписантов.Представление КАК Представление,
		|		ТипыПодписантов.Код КАК Код,
		|		ТипыПодписантов.ИдентификаторДляФормул КАК ИдентификаторДляФормул,
		|		МАКСИМУМ(Рег1.Период) КАК Период
		|	ИЗ
		|		ВТ КАК ВТ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Рег1 КАК Рег1
		|			ПО ВТ.ОбъектПодписанта = Рег1.ОбъектПодписанта
		|				И ВТ.Дата >= Рег1.Период
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТипыПодписантов КАК ТипыПодписантов
		|			ПО (Рег1.ТипПодписанта = ТипыПодписантов.ТипПодписанта)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ.ИндексСтроки,
		|		ВТ.ОбъектПодписанта,
		|		ВТ.Дата,
		|		ТипыПодписантов.ТипПодписанта,
		|		ТипыПодписантов.Наименование,
		|		ТипыПодписантов.Представление,
		|		ТипыПодписантов.Код,
		|		ТипыПодписантов.ИдентификаторДляФормул) КАК Т
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Рег1 КАК Рег1
		|		ПО Т.ОбъектПодписанта = Рег1.ОбъектПодписанта
		|			И Т.ТипПодписанта = Рег1.ТипПодписанта
		|			И Т.Период = Рег1.Период
		|
		|
		|ИНДЕКСИРОВАТЬ ПО
