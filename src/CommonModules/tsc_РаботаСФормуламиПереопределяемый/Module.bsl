Процедура ПолучитьКадровыеДанныеСотрудника(ТаблицаДанных, ИдентификаторАлгоритма, КолонкаРезультат, КолонкаИсточник, ДополнительныеВыраженияАлгоритма, Контекст, КешДанных, ТекстОшибки = "") Экспорт 
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения") Тогда
		Возврат;
	КонецЕсли;
	
	МодульКадровыйУчет = ОбщегоНазначения.ОбщийМодуль("КадровыйУчет");
	
	//КадровыйУчет.КадровыеДанныеФизическихЛиц(   //КадровыйУчет.КадровыеДанныеСотрудников(
	ПараметрыАлгоритма = СтрРазделить(ИдентификаторАлгоритма, "|");
	Код = ПараметрыАлгоритма[0];
	КолонкаЗапроса = ПараметрыАлгоритма[1]; 
	
	ТекущаяДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	ИмяКолонкиДата = Неопределено;
	Если ДополнительныеВыраженияАлгоритма.Количество() > 0 Тогда
		СтруктураВыражениеКолонка = ДополнительныеВыраженияАлгоритма[0];
		ИмяКолонкиДата = СтруктураВыражениеКолонка.ИмяКолонки;
	КонецЕсли;
	
	ЗапросыПоДате = Новый Соответствие;
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[КолонкаИсточник]) Тогда
			Продолжить;
		КонецЕсли;
		Поиск = Новый Структура;
		Поиск.Вставить("СотрудникФизлицо", СтрокаТаблицы[КолонкаИсточник]);
		//Поиск.Вставить("Код", Код);
		Если ИмяКолонкиДата = Неопределено Тогда
			Поиск.Вставить("Дата", ТекущаяДатаСеанса);
		Иначе
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонкиДата]) Тогда
				Поиск.Вставить("Дата", ТекущаяДатаСеанса);                    
			Иначе
				Поиск.Вставить("Дата", СтрокаТаблицы[ИмяКолонкиДата]);
			КонецЕсли;
		КонецЕсли;
		Если ЗапросыПоДате.Получить(Поиск.Дата) = Неопределено Тогда
			ЗапросыПоДате.Вставить(Поиск.Дата, Новый Структура("Сотрудники, Физлица, ИндексыСтрок", Новый Массив, Новый Массив, Новый Массив)); 	
		КонецЕсли;
		СтруктураСотрудникиФизлица = ЗапросыПоДате.Получить(Поиск.Дата);
		Если ТипЗнч(Поиск.СотрудникФизлицо) = Тип("СправочникСсылка.Сотрудники") Тогда
			Если СтруктураСотрудникиФизлица.Сотрудники.Найти(Поиск.СотрудникФизлицо) = Неопределено Тогда
				СтруктураСотрудникиФизлица.Сотрудники.Добавить(Поиск.СотрудникФизлицо);
			КонецЕсли;
		//ИначеЕсли ТипЗнч(Поиск.СотрудникФизлицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		//	Если СтруктураСотрудникиФизлица.Физлица.Найти(Поиск.СотрудникФизлицо) = Неопределено Тогда
		//		СтруктураСотрудникиФизлица.Физлица.Добавить(Поиск.СотрудникФизлицо);
		//	КонецЕсли;
		КонецЕсли;
		Если СтруктураСотрудникиФизлица.ИндексыСтрок.Найти(СтрокаТаблицы.ИндексСтроки) = Неопределено Тогда
			СтруктураСотрудникиФизлица.ИндексыСтрок.Добавить(СтрокаТаблицы.ИндексСтроки);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДанных.Индексы.Очистить();
	ТаблицаДанных.Индексы.Добавить("ИндексСтроки");
	Если ЗапросыПоДате.Количество() > 0 Тогда
		Для каждого КлючИЗначение Из ЗапросыПоДате Цикл
			Дата = КлючИЗначение.Ключ;	
			СтруктураСотрудникиФизлица = КлючИЗначение.Значение;		
			Если СтруктураСотрудникиФизлица.Сотрудники.Количество() > 0 Тогда
				Результат = МодульКадровыйУчет.КадровыеДанныеСотрудников(Истина, СтруктураСотрудникиФизлица.Сотрудники,КолонкаЗапроса, Дата);
			//ИначеЕсли СтруктураСотрудникиФизлица.Физлица.Количество() > 0 Тогда
				//Результат = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, СтруктураСотрудникиФизлица.Сотрудники,КолонкаЗапроса, Дата);
			КонецЕсли;
			ИндексыСтрок = СтруктураСотрудникиФизлица.ИндексыСтрок;
			Если ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
				Для каждого ИндексСтроки Из ИндексыСтрок Цикл
					НайденныеСтроки = ТаблицаДанных.НайтиСтроки(Новый Структура("ИндексСтроки", ИндексСтроки));
					Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
						ЗначениеПоиска = НайденнаяСтрока[КолонкаИсточник];
						Если ИмяКолонкиДата = Неопределено Тогда
							Дата = ТекущаяДатаСеанса;
						Иначе	
							Дата = НайденнаяСтрока[ИмяКолонкиДата];
						КонецЕсли;
						СтрокиРезультата = Результат.НайтиСтроки(Новый Структура("Сотрудник, Период", ЗначениеПоиска, Дата));
						Если СтрокиРезультата.Количество() > 0 Тогда
							Попытка
							    // В оригинале получение значений было через попытку. Например, для
								// получения Регистратора колонки не совпадают. Нужно делать или 
								// доуточнения через Если Тогда, либо получение данных через попытку.
								НайденнаяСтрока[КолонкаРезультат] = СтрокиРезультата[0][КолонкаЗапроса];
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЦикла;
				
			
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;	                                               
		
		
	КонецЕсли;
	ТаблицаДанных.Индексы.Очистить();

		
КонецПроцедуры 

