		|		КОГДА НЕ ВТПодписантыБезУчетаОтсутствий.Сотрудник ЕСТЬ NULL
		|				И СостоянияСотрудников.Сотрудник ЕСТЬ NULL
		|			ТОГДА ВТПодписантыБезУчетаОтсутствий.ФизическоеЛицо.Инициалы
		|		КОГДА НЕ ВТПодписантыБезУчетаОтсутствий.Сотрудник ЕСТЬ NULL
		|				И НЕ СостоянияСотрудников.Сотрудник ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА НЕ ВТПодписантыБезУчетаОтсутствий.ЗаместительСотр ЕСТЬ NULL
		|							И СостоянияСотрудниковЗаместитель.Сотрудник ЕСТЬ NULL
		|						ТОГДА ВТПодписантыБезУчетаОтсутствий.ФизическоеЛицоЗаместитель.Инициалы
		|					КОГДА НЕ ВТПодписантыБезУчетаОтсутствий.ЗаместительСотр ЕСТЬ NULL
		|								И НЕ СостоянияСотрудниковЗаместитель.Сотрудник ЕСТЬ NULL
		|							ИЛИ ВТПодписантыБезУчетаОтсутствий.ЗаместительСотр ЕСТЬ NULL
		|						ТОГДА НЕОПРЕДЕЛЕНО
		|				КОНЕЦ
		|	КОНЕЦ КАК Инициалы
		|ИЗ
		|	ВТПодписантыБезУчетаОтсутствий КАК ВТПодписантыБезУчетаОтсутствий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСотрудников КАК СостоянияСотрудников
		|		ПО ВТПодписантыБезУчетаОтсутствий.Сотрудник = СостоянияСотрудников.Сотрудник
		|			И (ВТПодписантыБезУчетаОтсутствий.Дата <= СостоянияСотрудников.ДействуетДо)
		|			И (ВТПодписантыБезУчетаОтсутствий.Дата >= СостоянияСотрудников.Период)
		|			И (СостоянияСотрудников.Состояние В (&СостоянияОтсутствияСотрудников))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСотрудников КАК СостоянияСотрудниковЗаместитель
		|		ПО ВТПодписантыБезУчетаОтсутствий.ЗаместительСотр = СостоянияСотрудниковЗаместитель.Сотрудник
		|			И (ВТПодписантыБезУчетаОтсутствий.Дата <= СостоянияСотрудниковЗаместитель.ДействуетДо)
		|			И (ВТПодписантыБезУчетаОтсутствий.Дата >= СостоянияСотрудниковЗаместитель.Период)
		|			И (СостоянияСотрудниковЗаместитель.Состояние В (&СостоянияОтсутствияСотрудников))";    
		
		
		Таблица = Запрос.Выполнить().Выгрузить();
		
		ТаблицаДанных.Индексы.Очистить();
		ТаблицаДанных.Индексы.Добавить("ИндексСтроки");
		Если НЕ ПроверитьВКеше Тогда
			КешДанных = Таблица;
		КонецЕсли;
		Если ПроверитьВКеше Тогда
			КешДанных.Индексы.Очистить();
			КешДанных.Индексы.Добавить("ОбъектПодписанта, Дата, ТипПодписанта");
		КонецЕсли;
			
		// Таблица получена по текущей ТаблицаДанных, так что можем искать строки по ИндексСтроки
		Для каждого Строка Из Таблица Цикл
			Если Строка.ТипПодписанта = ТипПодписанта Тогда
				ИндексСтроки = Строка.ИндексСтроки;
				ИсходнаяСтрока = ТаблицаДанных.Найти(ИндексСтроки, "ИндексСтроки");
				Если НЕ ИсходнаяСтрока = Неопределено Тогда
					ИсходнаяСтрока[КолонкаРезультат] = Строка[КолонкаЗапроса];
				КонецЕсли;
			КонецЕсли;
			
			Если ПроверитьВКеше Тогда
				ПоискВКеше = Новый Структура("ОбъектПодписанта, Дата, ТипПодписанта");
				ЗаполнитьЗначенияСвойств(ПоискВКеше, Строка);
				НайдСтрокиКеша = КешДанных.НайтиСтроки(ПоискВКеше);
				Если НайдСтрокиКеша.Количество() = 0 Тогда
					СтрокаКеша = КешДанных.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаКеша, Строка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		ТаблицаДанных.Индексы.Очистить();
	КонецЕсли;

	
	
КонецПроцедуры

Процедура ПолучитьОтветственноеЛицо(ТаблицаДанных, ИдентификаторАлгоритма, КолонкаРезультат, КолонкаИсточник, ДополнительныеВыраженияАлгоритма, Контекст, КешДанных, ТекстОшибки = "") Экспорт 
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыАлгоритма = СтрРазделить(ИдентификаторАлгоритма, "|");
	Код = ПараметрыАлгоритма[0];
	КолонкаЗапроса = ПараметрыАлгоритма[1]; 
	
	ПроверитьВКеше = Истина;
	Если КешДанных = Неопределено Тогда
		КешДанных = Новый ТаблицаЗначений;
		ПроверитьВКеше = Ложь;
	КонецЕсли;
	Если ТипЗнч(КешДанных) = Тип("ТаблицаЗначений") Тогда
		Если КешДанных.Колонки.Количество() = 0 Тогда
			ПроверитьВКеше = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	ИмяКолонкиДата = Неопределено;
	Если ДополнительныеВыраженияАлгоритма.Количество() > 0 Тогда
		СтруктураВыражениеКолонка = ДополнительныеВыраженияАлгоритма[0];
		ИмяКолонкиДата = СтруктураВыражениеКолонка.ИмяКолонки;
	КонецЕсли;
	
	СтрокиКЗапросу = Новый Массив;
	Если ПроверитьВКеше Тогда
		КешДанных.Индексы.Очистить();
		КешДанных.Индексы.Добавить("Организация, Код, Дата");
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[КолонкаИсточник]) Тогда
				Продолжить;
			КонецЕсли;
			Поиск = Новый Структура;
			Поиск.Вставить("Организация", СтрокаТаблицы[КолонкаИсточник]);
			Поиск.Вставить("Код", Код);
			Если ИмяКолонкиДата = Неопределено Тогда
				Поиск.Вставить("Дата", ТекущаяДатаСеанса);
			Иначе
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонкиДата]) Тогда
					Поиск.Вставить("Дата", ТекущаяДатаСеанса);
				Иначе
					Поиск.Вставить("Дата", СтрокаТаблицы[ИмяКолонкиДата]);
				КонецЕсли;
			КонецЕсли;
			
			НайденныеСтроки = КешДанных.НайтиСтроки(Поиск);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокиКЗапросу.Добавить(СтрокаТаблицы);
			Иначе
				СтрокаТаблицы[КолонкаРезультат] = НайденныеСтроки[0][КолонкаЗапроса];
			КонецЕсли;
		КонецЦикла;
		КешДанных.Индексы.Очистить();
	КонецЕсли;
	
	Если ПроверитьВКеше = Ложь
		ИЛИ СтрокиКЗапросу.Количество() > 0 Тогда
	
		ТаблицаВЗапрос = Новый ТаблицаЗначений;
		ТаблицаВЗапрос.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0,ДопустимыйЗнак.Неотрицательный)));
		ТаблицаВЗапрос.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ТаблицаВЗапрос.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		
	КонецЕсли;
	Если ПроверитьВКеше = Ложь Тогда
		Коллекциия = ТаблицаДанных;
	Иначе
		Коллекциия = СтрокиКЗапросу;
	КонецЕсли;
	Для каждого ИсходнаяСтрока Из Коллекциия Цикл
		Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока[КолонкаИсточник]) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаВЗапрос.Добавить();
		НоваяСтрока.ИндексСтроки = ИсходнаяСтрока.ИндексСтроки;
		НоваяСтрока.Организация = ИсходнаяСтрока[КолонкаИсточник];
		Если ИмяКолонкиДата = Неопределено Тогда
			НоваяСтрока.Дата = ТекущаяДатаСеанса;
		Иначе
			НоваяСтрока.Дата = ИсходнаяСтрока[ИмяКолонкиДата];	
			Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока[ИмяКолонкиДата]) Тогда
				НоваяСтрока.Дата = ТекущаяДатаСеанса;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПроверитьВКеше = Ложь
		ИЛИ СтрокиКЗапросу.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаВЗапрос", ТаблицаВЗапрос);
		Запрос.УстановитьПараметр("ФизическиеЛица_ПустаяСсылка", Справочники["ФизическиеЛица"].ПустаяСсылка());
	
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ИндексСтроки КАК ИндексСтроки,
		|	Т.Организация КАК Организация,
		|	Т.Дата КАК Дата
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТаблицаВЗапрос КАК Т
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Т.Организация,
		|	Т.Дата
		|;
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""Руководитель"" КАК Код
		|ПОМЕСТИТЬ ВТ_Коды
		|
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ВыбранныйПодписант""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ГлавныйБухгалтер""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Кассир""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""РуководительКадровойСлужбы""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ОтветственныйЗаВУР""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ОтветственныйЗаОхрануТруда""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ПредставительСФР""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Рег.Период КАК Период,
		|	Рег.Организация КАК Организация,
		|	Рег.Руководитель КАК Руководитель,
		|	Рег.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
		|	Рег.Кассир КАК Кассир,
		|	Рег.РуководительКадровойСлужбы КАК РуководительКадровойСлужбы,
		|	Рег.ОтветственныйЗаВУР КАК ОтветственныйЗаВУР,
		|	Рег.ОтветственныйЗаОхрануТруда КАК ОтветственныйЗаОхрануТруда,
		|	Рег.ПредставительСФР КАК ПредставительСФР
		|ПОМЕСТИТЬ Рег1
		|ИЗ
		|	РегистрСведений.СведенияОбОтветственныхЛицах КАК Рег
		|ГДЕ
		|	Рег.Организация В (ВЫБРАТЬ ВТ.Организация ИЗ ВТ КАК ВТ)
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация, 
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ 
		|	Т.ИндексСтроки КАК ИндексСтроки, 
		|	Т.Организация КАК Организация,
		|	Т.Дата КАК Дата,
		|	Т.Код КАК Код,
		|	Т.Период КАК Период,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА Т.Код = ""Руководитель""
		|			ТОГДА ЕСТЬNULL(Рег1.Руководитель, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""ВыбранныйПодписант""
		|			ТОГДА ЕСТЬNULL(Рег1.Руководитель, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""ГлавныйБухгалтер""
		|			ТОГДА ЕСТЬNULL(Рег1.ГлавныйБухгалтер, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""Кассир""
		|			ТОГДА ЕСТЬNULL(Рег1.Кассир, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""РуководительКадровойСлужбы""
		|			ТОГДА ЕСТЬNULL(Рег1.РуководительКадровойСлужбы, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""ОтветственныйЗаВУР""
		|			ТОГДА ЕСТЬNULL(Рег1.ОтветственныйЗаВУР, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""ОтветственныйЗаОхрануТруда""
		|			ТОГДА ЕСТЬNULL(Рег1.ОтветственныйЗаОхрануТруда, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|		КОГДА Т.Код = ""ПредставительСФР""
		|			ТОГДА ЕСТЬNULL(Рег1.ПредставительСФР, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
		|	КОНЕЦ) КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТ2
		|ИЗ 
		|	(ВЫБРАТЬ    
		|		ВТ.ИндексСтроки КАК ИндексСтроки, 
		|		ВТ.Организация,
		|		ВТ.Дата,
		|		ВТ_Коды.Код,
		|		МАКСИМУМ(ЕСТЬNULL(Рег1.Период, ДАТАВРЕМЯ(1,1,1))) КАК Период
		|	ИЗ ВТ КАК ВТ
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Коды КАК ВТ_Коды
		|	ПО ИСТИНА
		|	ЛЕВОЕ СОЕДИНЕНИЕ Рег1 КАК Рег1
		|	ПО ВТ.Организация = Рег1.Организация
		|		И ВТ.Дата >= Рег1.Период
		|		И ВЫБОР
		|			КОГДА ВТ_Коды.Код = ""Руководитель""
		|				ТОГДА Рег1.Руководитель <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""ВыбранныйПодписант""
		|				ТОГДА Рег1.Руководитель <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""ГлавныйБухгалтер""
		|				ТОГДА Рег1.ГлавныйБухгалтер <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""Кассир""
		|				ТОГДА Рег1.Кассир <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""РуководительКадровойСлужбы""
		|				ТОГДА Рег1.РуководительКадровойСлужбы <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""ОтветственныйЗаВУР""
		|				ТОГДА Рег1.ОтветственныйЗаВУР <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""ОтветственныйЗаОхрануТруда""
		|				ТОГДА Рег1.ОтветственныйЗаОхрануТруда <> &ФизическиеЛица_ПустаяСсылка
		|			КОГДА ВТ_Коды.Код = ""ПредставительСФР""
		|				ТОГДА Рег1.ПредставительСФР <> &ФизическиеЛица_ПустаяСсылка
		|		КОНЕЦ
		|	СГРУППИРОВАТЬ ПО 
		|		ВТ.ИндексСтроки,
		|		ВТ.Организация,
		|		ВТ.Дата,
		|		ВТ_Коды.Код) КАК Т
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	Рег1 КАК Рег1
		|ПО
		|	Т.Организация = Рег1.Организация
		|	И Т.Период = Рег1.Период
		|	И ВЫБОР
		|		КОГДА Т.Код = ""Руководитель""
		|			ТОГДА Рег1.Руководитель <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""ВыбранныйПодписант""
		|			ТОГДА Рег1.Руководитель <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""ГлавныйБухгалтер""
		|			ТОГДА Рег1.ГлавныйБухгалтер <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""Кассир""
		|			ТОГДА Рег1.Кассир <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""РуководительКадровойСлужбы""
		|			ТОГДА Рег1.РуководительКадровойСлужбы <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""ОтветственныйЗаВУР""
		|			ТОГДА Рег1.ОтветственныйЗаВУР <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""ОтветственныйЗаОхрануТруда""
		|			ТОГДА Рег1.ОтветственныйЗаОхрануТруда <> &ФизическиеЛица_ПустаяСсылка
		|		КОГДА Т.Код = ""ПредставительСФР""
		|			ТОГДА Рег1.ПредставительСФР <> &ФизическиеЛица_ПустаяСсылка
		|	КОНЕЦ
		|СГРУППИРОВАТЬ ПО
		|	Т.ИндексСтроки,
		|	Т.Организация,
		|	Т.Дата,
		|	Т.Код,
		|	Т.Период	
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ 
		|	ВТ2.ИндексСтроки КАК ИндексСтроки,
		|	ВТ2.Организация КАК Организация,
		|	ВТ2.Код КАК Код,
		|	ВТ2.Дата КАК Дата,
		|	ВТ2.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВТ2.Код КАК НаименованиеТипа,
		|	ОснованияПолномочийОтветственныхЛиц.ОснованиеПодписи КАК ОснованиеПодписи,
		|	ОснованияПолномочийОтветственныхЛиц.Должность КАК Должность,
		|	ОснованияПолномочийОтветственныхЛиц.ДатаНачала КАК ДатаНачала,
		|	ОснованияПолномочийОтветственныхЛиц.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	ВТ2 КАК ВТ2
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияПолномочийОтветственныхЛиц КАК ОснованияПолномочийОтветственныхЛиц
		|		ПО (ВТ2.Организация = ОснованияПолномочийОтветственныхЛиц.Организация)
		|			И (ВТ2.ФизическоеЛицо = ОснованияПолномочийОтветственныхЛиц.ФизическоеЛицо)";    
		
		Таблица = Запрос.Выполнить().Выгрузить();
		
		ТаблицаДанных.Индексы.Очистить();
		ТаблицаДанных.Индексы.Добавить("ИндексСтроки");
		Если НЕ ПроверитьВКеше Тогда
			КешДанных = Таблица;
		КонецЕсли;
		
		Если ПроверитьВКеше Тогда
			КешДанных.Индексы.Очистить();
			КешДанных.Индексы.Добавить("Организация, Код, Дата");
		КонецЕсли;
			
		// Таблица получена по текущей ТаблицаДанных, так что можем искать строки по ИндексСтроки
		Для каждого Строка Из Таблица Цикл
			Если Строка.Код = Код Тогда
				ИндексСтроки = Строка.ИндексСтроки;
				ИсходнаяСтрока = ТаблицаДанных.Найти(ИндексСтроки, "ИндексСтроки");
				Если НЕ ИсходнаяСтрока = Неопределено Тогда
					ИсходнаяСтрока[КолонкаРезультат] = Строка[КолонкаЗапроса];	
				КонецЕсли;
			КонецЕсли;
			Если ПроверитьВКеше Тогда
				ПоискВКеше = Новый Структура("Организация, Код, Дата");
				ЗаполнитьЗначенияСвойств(ПоискВКеше, Строка);
				НайдСтрокиКеша = КешДанных.НайтиСтроки(ПоискВКеше);
				Если НайдСтрокиКеша.Количество() = 0 Тогда
					СтрокаКеша = КешДанных.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаКеша, Строка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		ТаблицаДанных.Индексы.Очистить();
	КонецЕсли;
КонецПроцедуры

