КонецПроцедуры

Процедура ДобавитьВыраженияСистемОбмена(Дерево) Экспорт
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ТЦР_УниверсальныйОбменДанными") Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеГруппыОператора = НСтр("ru = 'Выражения систем обмена';
										|en = 'Expressions of exchange systems'");
	ГруппаОператоров = tsc_РаботаСФормулами.ДобавитьГруппуОператоров(Дерево, "ВыраженияСистемОбмена", ПредставлениеГруппыОператора);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТЦР_УниверсальныйОбменДанными.АнализОшибокОбменов") Тогда
		ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль("ТЦР_РаботаСОшибкамиОбмена");
		СписокСистемОбмена = ОбщийМодуль.СписокСистемОбмена();
	Иначе
		СписокСистемОбмена = Новый СписокЗначений;
		ИмяСправочникКонстанты = "ТЦР_Константы";
		Выборка = Справочники[ИмяСправочникКонстанты].Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокСистемОбмена.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;
	Для каждого ЭлементСписка Из СписокСистемОбмена Цикл
		Система = ЭлементСписка.Значение;
		Предопределенный = Ложь;
		ИмяПредопределенныхДанных = "";
		Если ТипЗнч(Система) = Тип("Строка") Тогда
			// Обмен с документооборотом
			ИдентификаторОператора = Система;
		Иначе
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Система, "Предопределенный, ИмяПредопределенныхДанных");
			Предопределенный = ЗначенияРеквизитов.Предопределенный;
			ИмяПредопределенныхДанных = ЗначенияРеквизитов.ИмяПредопределенныхДанных;
			Если Предопределенный Тогда
				ИдентификаторОператора = ИмяПредопределенныхДанных;
			Иначе
				ИдентификаторОператора = ЭлементСписка.Представление;
			КонецЕсли;
		КонецЕсли;
		ПредставлениеОператора = ЭлементСписка.Представление;
		
		Если ТипЗнч(Система) = Тип("Строка") Тогда
			ОператорНаЯзыкеКодаДляВставки = СтрШаблон("""%1""", Система);
		Иначе
			СтрШаблон("Справочники.ТЦР_ИнтегрируемыеСистемы.%1", ИмяПредопределенныхДанных);
		КонецЕсли;
		ОператорНаЯзыкеКодаДляВставки = "Макс(,)";
		ПояснениеОператора = "";
		
		tsc_РаботаСФормулами.ДобавитьОператор(ГруппаОператоров,
			ИдентификаторОператора,
			ОператорНаЯзыкеКодаДляВставки,
			ПредставлениеОператора,
			ПояснениеОператора,
			2);
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ДобавитьФункцииДляПолученияЗначенийКонстантТЦР(Дерево)
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ТЦР_УниверсальныйОбменДанными") Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеГруппыОператора = НСтр("ru = 'Функции для получения значений констант ТЦР';
										|en = 'Functions for obtaining the values of the TCR constants'");
	ГруппаОператоров = tsc_РаботаСФормулами.ДобавитьГруппуОператоров(Дерево, "ФункцииДляПолученияЗначенийКонстантТЦР", ПредставлениеГруппыОператора);
	
	
	//
	ИдентификаторОператора = "ЗначениеКонстантыТЦР";
	ПредставлениеОператора = НСтр("ru = 'ЗначениеКонстантыТЦР(';
									|en = 'TheValueOfTheTCRConstant('");
	ПояснениеОператора = НСтр("ru = 'Получает значение константы ТЦР.';
								|en = 'Gets the value of the TCR constant.'");
	
	ОператорНаЯзыкеКодаДляВставки = СтрШаблон("Справочники.ТЦР_Константы.ДанныеКонстанты(Справочники.ТЦР_Константы.<%1>).Значение", 
				Нстр("ru = 'Имя константы'"));
	tsc_РаботаСФормулами.ДобавитьОператор(ГруппаОператоров,
		ИдентификаторОператора,
		ОператорНаЯзыкеКодаДляВставки,
		ПредставлениеОператора,
		ПояснениеОператора,
		2);
		
	//
	ИдентификаторОператора = "ТаблицаЗначенийКонстантыТЦР";
	ПредставлениеОператора = НСтр("ru = 'ТаблицаЗначенийКонстантыТЦР(';
									|en = 'TableOfValuesOfTheConstantOfTheTCR('");
	ПояснениеОператора = НСтр("ru = 'Получает таблицу значений константы ТЦР.';
								|en = 'Gets a table of values of the TCR constant.'");
	
	ОператорНаЯзыкеКодаДляВставки = СтрШаблон("Справочники.ТЦР_Константы.ДанныеКонстанты(Справочники.ТЦР_Константы.<%1>).ТаблицаЗначений", 
				Нстр("ru = 'Имя константы'"));
	tsc_РаботаСФормулами.ДобавитьОператор(ГруппаОператоров,
		ИдентификаторОператора,
		ОператорНаЯзыкеКодаДляВставки,
		ПредставлениеОператора,
		ПояснениеОператора,
		2);
	
	//
	ИдентификаторОператора = "СписокЗначенийКонстантыТЦР";
	ПредставлениеОператора = НСтр("ru = 'СписокЗначенийКонстантыТЦР(';
									|en = 'ListOfValuesOfTheConstantOfTheTCR('");
	ПояснениеОператора = НСтр("ru = 'Получает список значений константы ТЦР.';
								|en = 'Gets a list of values for the TCR constant.'");
	
	ОператорНаЯзыкеКодаДляВставки = СтрШаблон("Справочники.ТЦР_Константы.ДанныеКонстанты(Справочники.ТЦР_Константы.<%1>).Значения", 
				Нстр("ru = 'Имя константы'"));
	tsc_РаботаСФормулами.ДобавитьОператор(ГруппаОператоров,
		ИдентификаторОператора,
		ОператорНаЯзыкеКодаДляВставки,
		ПредставлениеОператора,
		ПояснениеОператора,
		2);
		
КонецПроцедуры

