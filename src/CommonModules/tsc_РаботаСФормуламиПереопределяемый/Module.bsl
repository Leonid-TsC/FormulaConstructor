#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ДополнитьТаблицуПоддерживаемыхСвойств(ТаблицаСвойств) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения") Тогда
		Свойства = ТаблицаСвойств.Добавить();
		Свойства.МетаданныеИсточника = Метаданные.ПланыВидовХарактеристик.ДолжностиПодключаемыеХарактеристики;
		Свойства.ПрефиксТипаВидаХарактеристик = "Длж.";
		Свойства.ПолеИдентификатора = "Наименование";
		Свойства.ПолеТипаЗначений = "ТипЗначения";
		Свойства.ИспользуетсяВыражениеТипаЗначений = Ложь;
		Свойства.ВыражениеТипаЗначений = "";
		Свойства.УникальностьИмениВПределахВсейТаблицыХарактеристик = Истина;
		
		Свойства = ТаблицаСвойств.Добавить();
		Свойства.МетаданныеИсточника = Метаданные.ПланыВидовХарактеристик.НачисленияПодключаемыеХарактеристики;
		Свойства.ПрефиксТипаВидаХарактеристик = "Нач.";
		Свойства.ПолеИдентификатора = "Наименование";
		Свойства.ПолеТипаЗначений = "ТипЗначения";
		Свойства.ИспользуетсяВыражениеТипаЗначений = Ложь;
		Свойства.ВыражениеТипаЗначений = "";
		Свойства.УникальностьИмениВПределахВсейТаблицыХарактеристик = Истина;
		
		Свойства = ТаблицаСвойств.Добавить();
		Свойства.МетаданныеИсточника = Метаданные.ПланыВидовХарактеристик.ШтатноеРасписаниеПодключаемыеХарактеристики;
		Свойства.ПрефиксТипаВидаХарактеристик = "ШтР.";
		Свойства.ПолеИдентификатора = "Наименование";
		Свойства.ПолеТипаЗначений = "ТипЗначения";
		Свойства.ИспользуетсяВыражениеТипаЗначений = Ложь;
		Свойства.ВыражениеТипаЗначений = "";
		Свойства.УникальностьИмениВПределахВсейТаблицыХарактеристик = Истина;
	КонецЕсли;
	
КонецПроцедуры  

Процедура ДополнитьТаблицуПоддерживаемыхСвойствАлгоритмов(ТаблицаСвойств) Экспорт
	
	#Область АлгоритмРуководителиОбъектов
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
		
		МодульТЦР_Руководители = ОбщегоНазначения.ОбщийМодуль("ТЦР_Руководители");
		МассивТиповОбъектовРуководителейИПодписантов = Новый Массив;
		МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникПодразделенияОрганизаций"].Тип.Типы()[0]);
		МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникШтатноеРасписание"].Тип.Типы()[0]);
		//МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникСотрудники"].Тип.Типы()[0]);
		МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникОрганизации"].Тип.Типы()[0]);
		
		МассивТиповРуководителей = МодульТЦР_Руководители.РуководителиОбъекта(Неопределено, ТекущаяДатаСеанса());
		
		СтрокаСвойств = ТаблицаСвойств.Добавить();
		СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "Рук.";
		СтрокаСвойств.МассивТиповИсточников = МассивТиповОбъектовРуководителейИПодписантов;
		СтрокаСвойств.Идентификатор = "Руководители";
		СтрокаСвойств.Представление = НСТр("ru = 'Руководители'");
		СтрокаСвойств.ЭтоГруппа = Истина;
		СтрокаСвойств.Родитель = "";
		
		Для каждого Строка Из МассивТиповРуководителей Цикл
				
			СтрокаСвойств = ТаблицаСвойств.Добавить();
			СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "Рук.";
			СтрокаСвойств.МассивТиповИсточников = МассивТиповОбъектовРуководителейИПодписантов;
			СтрокаСвойств.Идентификатор = Строка.ИдентификаторДляФормул;
			СтрокаСвойств.Представление = Строка.Представление;
			СтрокаСвойств.ЭтоГруппа = Истина;
			СтрокаСвойств.Родитель = "Руководители";
			
			Для каждого Колонка Из МассивТиповРуководителей.Колонки Цикл
				Если Колонка.Имя = "Предствление"
					ИЛИ Колонка.Имя = "ИдентификаторДляФормул" Тогда
					Продолжить;
				КонецЕсли;
					
				СтрокаСвойств = ТаблицаСвойств.Добавить();
				СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "Рук.";
				СтрокаСвойств.МассивТиповИсточников = МассивТиповОбъектовРуководителейИПодписантов;
				СтрокаСвойств.Идентификатор = СтрШаблон("%1|%2", Строка.ИдентификаторДляФормул, Колонка.Имя);
				
				ТипКолонки = Колонка.ТипЗначения;
				Типы = ТипКолонки.Типы();
				ТипNull = Типы.Найти(Тип("Null"));
				Если НЕ ТипNull = Неопределено Тогда
					Типы.Удалить(ТипNull);
				КонецЕсли;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Новый ОписаниеТипов(Типы,ТипКолонки.КвалификаторыЧисла,ТипКолонки.КвалификаторыСтроки,ТипКолонки.КвалификаторыДаты);
				
				СтрокаСвойств.Представление = Колонка.Имя;
				СтрокаСвойств.ЭтоГруппа = Ложь;
				СтрокаСвойств.Родитель = Строка.ИдентификаторДляФормул;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Колонка.ТипЗначения;
				СтрокаСвойств.ФункцияДляВычисления = "tsc_РаботаСФормуламиПереопределяемый.ПолучитьРуководителя";
				СтрокаСвойств.ФункцияУказанияДопКолонокПриРазвертке = "tsc_РаботаСФормуламиПереопределяемый.ПриВыводеАлгоритмаВДеревеОперандов"; 
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область АлгоритмПодписантовОбъектов
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
		
		МодульТЦР_Подписанты = ОбщегоНазначения.ОбщийМодуль("ТЦР_Подписанты");
		МассивТиповОбъектовРуководителейИПодписантов = Новый Массив;
		МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникПодразделенияОрганизаций"].Тип.Типы()[0]);
		МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникШтатноеРасписание"].Тип.Типы()[0]);
		//МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникСотрудники"].Тип.Типы()[0]);
		МассивТиповОбъектовРуководителейИПодписантов.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникОрганизации"].Тип.Типы()[0]);
		
		МассивТиповПодписантов	 = МодульТЦР_Подписанты.ПодписантыОбъекта(Неопределено, ТекущаяДатаСеанса());
		
		СтрокаСвойств = ТаблицаСвойств.Добавить();
		СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "Подп.";
		СтрокаСвойств.МассивТиповИсточников = МассивТиповОбъектовРуководителейИПодписантов;
		СтрокаСвойств.Идентификатор = "Подписанты";
		СтрокаСвойств.Представление = НСТр("ru = 'Подписанты'");
		СтрокаСвойств.ЭтоГруппа = Истина;
		СтрокаСвойств.Родитель = "";
		
		Для каждого Строка Из МассивТиповПодписантов Цикл
				
			СтрокаСвойств = ТаблицаСвойств.Добавить();
			СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "Подп.";
			СтрокаСвойств.МассивТиповИсточников = МассивТиповОбъектовРуководителейИПодписантов;
			СтрокаСвойств.Идентификатор = Строка.ИдентификаторДляФормул;
			СтрокаСвойств.Представление = Строка.Представление;
			СтрокаСвойств.ЭтоГруппа = Истина;
			СтрокаСвойств.Родитель = "Подписанты";
			
			Для каждого Колонка Из МассивТиповПодписантов.Колонки Цикл
				Если Колонка.Имя = "Предствление"
					ИЛИ Колонка.Имя = "ИдентификаторДляФормул" Тогда
					Продолжить;
				КонецЕсли;
					
				СтрокаСвойств = ТаблицаСвойств.Добавить();
				СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "Подп.";
				СтрокаСвойств.МассивТиповИсточников = МассивТиповОбъектовРуководителейИПодписантов;
				СтрокаСвойств.Идентификатор = СтрШаблон("%1|%2", Строка.ИдентификаторДляФормул, Колонка.Имя);
				
				ТипКолонки = Колонка.ТипЗначения;
				Типы = ТипКолонки.Типы();
				ТипNull = Типы.Найти(Тип("Null"));
				Если НЕ ТипNull = Неопределено Тогда
					Типы.Удалить(ТипNull);
				КонецЕсли;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Новый ОписаниеТипов(Типы,ТипКолонки.КвалификаторыЧисла,ТипКолонки.КвалификаторыСтроки,ТипКолонки.КвалификаторыДаты);
				
				СтрокаСвойств.Представление = Колонка.Имя;
				СтрокаСвойств.ЭтоГруппа = Ложь;
				СтрокаСвойств.Родитель = Строка.ИдентификаторДляФормул;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Колонка.ТипЗначения;
				СтрокаСвойств.ФункцияДляВычисления = "tsc_РаботаСФормуламиПереопределяемый.ПолучитьПодписанта";
				СтрокаСвойств.ФункцияУказанияДопКолонокПриРазвертке = "tsc_РаботаСФормуламиПереопределяемый.ПриВыводеАлгоритмаВДеревеОперандов";
			КонецЦикла;
		
		КонецЦикла;
	
	КонецЕсли;
	
	#КонецОбласти
	
	#Область АлгоритмОтветственныхЛиц
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
	
		МодульТЦР_Подписанты = ОбщегоНазначения.ОбщийМодуль("ТЦР_Подписанты");
		МассивТиповОтветственныхЛиц = Новый Массив;
		МассивТиповОтветственныхЛиц.Добавить(Метаданные.ОпределяемыеТипы["ТЦР_СправочникОрганизации"].Тип.Типы()[0]);
		
		МассивОтветстенныхЛиц = МодульТЦР_Подписанты.ОтветственныеЛицаОбъекта(Неопределено, ТекущаяДатаСеанса());
		
		СтрокаСвойств = ТаблицаСвойств.Добавить();
		СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "ОтвЛ.";
		СтрокаСвойств.МассивТиповИсточников = МассивТиповОтветственныхЛиц;
		СтрокаСвойств.Идентификатор = "ОтветственныеЛица";
		СтрокаСвойств.Представление = НСТр("ru = 'Ответственные лица'");
		СтрокаСвойств.ЭтоГруппа = Истина;
		СтрокаСвойств.Родитель = "";
		
		Для каждого Строка Из МассивОтветстенныхЛиц Цикл
				
			СтрокаСвойств = ТаблицаСвойств.Добавить();
			СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "ОтвЛ.";
			СтрокаСвойств.МассивТиповИсточников = МассивТиповОтветственныхЛиц;
			СтрокаСвойств.Идентификатор = Строка.Код;
			СтрокаСвойств.Представление = Строка.НаименованиеТипа;
			СтрокаСвойств.ЭтоГруппа = Истина;
			СтрокаСвойств.Родитель = "ОтветственныеЛица";
			
			Для каждого Колонка Из МассивОтветстенныхЛиц.Колонки Цикл
				СтрокаСвойств = ТаблицаСвойств.Добавить();
				СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "ОтвЛ.";
				СтрокаСвойств.МассивТиповИсточников = МассивТиповОтветственныхЛиц;
				СтрокаСвойств.Идентификатор = СтрШаблон("%1|%2", Строка.Код, Колонка.Имя);
				
				ТипКолонки = Колонка.ТипЗначения;
				Типы = ТипКолонки.Типы();
				ТипNull = Типы.Найти(Тип("Null"));
				Если НЕ ТипNull = Неопределено Тогда
					Типы.Удалить(ТипNull);
				КонецЕсли;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Новый ОписаниеТипов(Типы,ТипКолонки.КвалификаторыЧисла,ТипКолонки.КвалификаторыСтроки,ТипКолонки.КвалификаторыДаты);
				
				СтрокаСвойств.Представление = Колонка.Имя;
				СтрокаСвойств.ЭтоГруппа = Ложь;
				СтрокаСвойств.Родитель = Строка.Код;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Колонка.ТипЗначения;
				СтрокаСвойств.ФункцияДляВычисления = "tsc_РаботаСФормуламиПереопределяемый.ПолучитьОтветственноеЛицо";
				СтрокаСвойств.ФункцияУказанияДопКолонокПриРазвертке = "tsc_РаботаСФормуламиПереопределяемый.ПриВыводеАлгоритмаВДеревеОперандов";
			КонецЦикла;
		
		КонецЦикла;
	
	КонецЕсли;

	#КонецОбласти
	
	

	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения")
		И ОбщегоНазначения.ПодсистемаСуществует("ТЦР_КонструкторПечатныхФорм") Тогда
		
		МодульТЦР_Печать = ОбщегоНазначения.ОбщийМодуль("ТЦР_Печать");
		МассивКДС = МодульТЦР_Печать.ПолучитьИменаКДСотрудников();
		МассивТипов = Метаданные.ОпределяемыеТипы["ТЦР_СправочникСотрудники"].Тип.Типы();
		
		СтрокаСвойств = ТаблицаСвойств.Добавить();
		СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "КДС.";
		СтрокаСвойств.МассивТиповИсточников = МассивТипов;
		СтрокаСвойств.Идентификатор = "КадровыеДанныеСотрудников";
		СтрокаСвойств.Представление = НСТр("ru = 'Кадровые данные (сотр.)'");
		СтрокаСвойств.ЭтоГруппа = Истина;
		СтрокаСвойств.Родитель = "";
		
		Для каждого СтруктураСвойств Из МассивКДС Цикл
			СтрокаСвойств = ТаблицаСвойств.Добавить();
			СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "КДС.";
			СтрокаСвойств.МассивТиповИсточников = МассивТипов;
			ИД = tsc_РаботаСФормуламиКлиентСервер.ИдентификаторДляФормул(СтруктураСвойств.ИмяПапки);
			СтрокаСвойств.Идентификатор = ИД;
			СтрокаСвойств.Представление = СтруктураСвойств.ИмяПапки;
			СтрокаСвойств.ЭтоГруппа = Истина;
			СтрокаСвойств.Родитель = "КадровыеДанныеСотрудников";
			
			Для каждого Имя Из СтруктураСвойств.МассивИмен Цикл
			
				СтрокаСвойств = ТаблицаСвойств.Добавить();
				СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "КДС.";
				СтрокаСвойств.МассивТиповИсточников = МассивТипов;
				ИД = tsc_РаботаСФормуламиКлиентСервер.ИдентификаторДляФормул(СтруктураСвойств.ИмяПапки);
				СтрокаСвойств.Идентификатор = СтрШаблон("%1|%2", ИД, Имя);
				СтрокаСвойств.Представление = Имя;
				СтрокаСвойств.ЭтоГруппа = Ложь;
				СтрокаСвойств.Родитель = ИД;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Неопределено; // Без дальнейшей развертки
				СтрокаСвойств.ФункцияДляВычисления = "tsc_РаботаСФормуламиПереопределяемый.ПолучитьКадровыеДанныеСотрудника";	
				СтрокаСвойств.ФункцияУказанияДопКолонокПриРазвертке = "tsc_РаботаСФормуламиПереопределяемый.ПриВыводеАлгоритмаВДеревеОперандов";
			КонецЦикла;
		КонецЦикла;
		
		МассивКДФ = МодульТЦР_Печать.ПолучитьИменаКДФизЛиц(); 
		МассивТипов = Метаданные.ОпределяемыеТипы["ТЦР_СправочникФизическиеЛица"].Тип.Типы();
		
		СтрокаСвойств = ТаблицаСвойств.Добавить();
		СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "КДФ.";
		СтрокаСвойств.МассивТиповИсточников = МассивТипов;
		СтрокаСвойств.Идентификатор = "КадровыеДанныеФизлиц";
		СтрокаСвойств.Представление = НСТр("ru = 'Кадровые данные (физ.лиц)'");
		СтрокаСвойств.ЭтоГруппа = Истина;
		СтрокаСвойств.Родитель = "";
		
		Для каждого СтруктураСвойств Из МассивКДФ Цикл
			СтрокаСвойств = ТаблицаСвойств.Добавить();
			СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "КДФ.";
			СтрокаСвойств.МассивТиповИсточников = МассивТипов;
			СтрокаСвойств.Идентификатор = СтруктураСвойств.ИмяПапки;
			СтрокаСвойств.Представление = СтруктураСвойств.ИмяПапки;
			СтрокаСвойств.ЭтоГруппа = Истина;
			СтрокаСвойств.Родитель = "КадровыеДанныеФизлиц";
			
			Для каждого Имя Из СтруктураСвойств.МассивИмен Цикл
			
				СтрокаСвойств = ТаблицаСвойств.Добавить();
				СтрокаСвойств.ПрефиксТипаВидаАлгоритма = "КДФ.";
				СтрокаСвойств.МассивТиповИсточников = МассивТипов;
				СтрокаСвойств.Идентификатор = СтрШаблон("%1|%2", СтруктураСвойств.ИмяПапки, Имя);
				СтрокаСвойств.Представление = Имя;
				СтрокаСвойств.ЭтоГруппа = Ложь;
				СтрокаСвойств.Родитель = СтруктураСвойств.ИмяПапки;
				СтрокаСвойств.ОписаниеТиповРезультатаВычисления = Неопределено; // Без дальнейшей развертки
				СтрокаСвойств.ФункцияДляВычисления = "tsc_РаботаСФормуламиПереопределяемый.ПолучитьКадровыеДанныеФизлица";	
				СтрокаСвойств.ФункцияУказанияДопКолонокПриРазвертке = "tsc_РаботаСФормуламиПереопределяемый.ПриВыводеАлгоритмаВДеревеОперандов";
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриВыводеАлгоритмаВДеревеОперандов(СтрокаДереваАлгоритмов, СтрокаДереваОперандовРодитель, СтруктураДопПараметров) Экспорт
	// См. ФункцияУказанияДопКолонокПриРазвертке
	КорневаяСтрока = tsc_РаботаСФормулами.КореневаяСтрокаДереваПоВыражению(СтрокаДереваОперандовРодитель, СтруктураДопПараметров.КореньВыражения);
	
	ЕстьДокументВКорне = Ложь;
	// Если в корне составной тип данных, например, справочник и документ, то
	// выражение "Корень.Дата" - вернет дату и null в СКД. В алгоритме необходимо проверить тип значения.
	Если ТипЗнч(КорневаяСтрока) = Тип("ДанныеФормыЭлементДерева") Тогда
		ТипЗначенияКорня = КорневаяСтрока.ТипЗначения;
		Если ТипЗнч(ТипЗначенияКорня) = Тип("ОписаниеТипов") Тогда
			Для каждого Тип Из ТипЗначенияКорня.Типы() Цикл
				МД = Метаданные.НайтиПоТипу(Тип);
				Если МД = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если Метаданные.Документы.Содержит(МД) Тогда
					ЕстьДокументВКорне = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ЕстьДокументВКорне Тогда
		// Добавляем колонку для вычисления даты документа, т.к. алгоритмы периодические ("КДФ.", "КДС." и др.)
		СтрокаДереваАлгоритмов.Идентификатор = СтрокаДереваАлгоритмов.Идентификатор + "$" + СтруктураДопПараметров.КореньВыражения + ".Дата";
	КонецЕсли;
КонецПроцедуры

#Область ДобавлениеОператоровВДеревоОператоровДляКонструктораФормул

Процедура ПриПостроенииДереваОператоров(Дерево, Параметры, УникальныйИдентификатор) Экспорт
	
	Если Параметры.Свойство("ВыраженияСистемОбмена") И Параметры.ВыраженияСистемОбмена Тогда
		ДобавитьВыраженияСистемОбмена(Дерево);
	КонецЕсли;
	
	Если Параметры.Свойство("ФункцииДляПолученияЗначенийОбъектов") И Параметры.ФункцииДляПолученияЗначенийОбъектов Тогда
		ДобавитьФункцииДляПолученияЗначенийОбъектов(Дерево);
	КонецЕсли;
	
	Если Параметры.Свойство("ФункцииДляПолученияЗначенийКонстантТЦР") И Параметры.ФункцииДляПолученияЗначенийКонстантТЦР Тогда
		ДобавитьФункцииДляПолученияЗначенийКонстантТЦР(Дерево);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Процедура ДополнитьПараметрыПостроенияДереваОператоров(Параметры) Экспорт
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.БазоваяФункциональность") Тогда
		Параметры.Вставить("ФункцииДляПолученияЗначенийОбъектов", Истина);
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует("ТЦР_УниверсальныйОбменДанными") Тогда
		Параметры.Вставить("ВыраженияСистемОбмена", Истина);
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует("ТЦР_УниверсальныйОбменДанными") Тогда
		Параметры.Вставить("ФункцииДляПолученияЗначенийКонстантТЦР", Истина);
	КонецЕсли;
КонецПроцедуры

