
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Текст = Параметры.Текст;
	ДляРедактирования = Параметры.ДляРедактирования;
	
	Если НЕ ДляРедактирования Тогда
		Элементы.Текст.ТолькоПросмотр = Истина;
		Элементы.ФормаОк.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Ок(Команда)
	Закрыть(Текст);
КонецПроцедуры
